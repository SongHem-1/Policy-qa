# docker-compose环境变量模板
# 复制本文件为 .env 后填入你的配置

# API密钥
ZHIPU_API_KEY=your_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 服务端口
API_PORT=8000
WEB_PORT=7862

# 模型配置
LLM_PROVIDER=zhipu
OPENAI_MODEL=glm-4-flash
MODEL_DIR=./MML12-v2

# HuggingFace镜像（加速下载）
HF_ENDPOINT=https://hf-mirror.com

# 文档处理
USE_MINERU=False

# 分块策略
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_BY_SECTION=False

# 重排序配置
USE_RERANKER=False
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=5
RERANKER_THRESHOLD=0.0

# 混合检索权重
BM25_WEIGHT=0.2
VECTOR_WEIGHT=0.8

# 自适应检索（查询分类 + 策略路由）
USE_ADAPTIVE_RETRIEVAL=True
USE_QUERY_EXPANSION=True